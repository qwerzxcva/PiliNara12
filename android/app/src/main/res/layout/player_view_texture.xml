<?xml version="1.0" encoding="utf-8"?>
<!--
  Kazumi 特性：TextureView 渲染器布局。

  Media3 1.5.1 的 PlayerView 未公开 setSurfaceType（已用 javap 核实），
  surface_type 只能在 inflate 时通过 XML 属性生效。
  因此提供两份布局（默认 SurfaceView / 本文件 TextureView），
  由代码按用户设置选择 inflate 哪一个。
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_view_texture"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:resize_mode="fit"
    app:show_next_button="false"
    app:show_previous_button="false"
    app:controller_auto_show="true"
    app:controller_show_timeout_ms="3000" />
